# =============================================================================
# ReTrack Code Reviewer — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# Database
DATABASE_URL=

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=                      # Production URL of your app (e.g. https://your-domain.com)

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=               # RSA private key in PEM format (escaped newlines)
GITHUB_APP_WEBHOOK_SECRET=
NEXT_PUBLIC_GITHUB_APP_NAME=          # GitHub App URL slug (e.g. retrack-code-reviewer)

# OpenRouter (AI)
OPENROUTER_API_KEY=

# Pinecone Vector DB
PINECONE_INDEX_NAME=
PINECONE_API_KEY=

# Razorpay (Billing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Client-side auth URL (optional — set if using ngrok or a custom domain in dev)
# NEXT_PUBLIC_BETTER_AUTH_URL=
